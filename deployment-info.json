{
  "schema": "bsv-app",
  "schemaVersion": "1.0",
  "topicManagers": {
    "tm_metamarket": "./backend/src/topic-managers/MarketTopicManager.ts"
  },
  "lookupServices": {
    "ls_metamarket": {
      "serviceFactory": "./backend/src/lookup-services/MarketLookupServiceFactory.ts",
      "hydrateWith": "mongo"
    }
  },
  "frontend": {
    "language": "react",
    "sourceDirectory": "./frontend"
  },
  "configs": [
    {
      "name": "Chabbage Server",
      "provider": "CARS",
      "CARSCloudURL": "https://cars.metanet.club",
      "projectID": "a6b7bb500651935a164fe28292dbb891",
      "network": "mainnet",
      "deploy": [
        "frontend",
        "backend"
      ],
      "frontendHostingMethod": "HTTPS"
    },
    {
      "name": "Local LARS",
      "network": "mainnet",
      "provider": "LARS",
      "run": [
        "backend",
        "frontend"
      ]
    }
  ]
